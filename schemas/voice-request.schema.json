{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rayray12zx3-sys/ai-voice-pipeline/schemas/voice-request.schema.json",
  "title": "AI Voice Pipeline request",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "voices", "turns"],
  "properties": {
    "model": {
      "type": "string",
      "enum": ["gemini-3.8-flash-tts", "gemini-3.8-flash-lite-tts"]
    },
    "output_mime_type": {
      "type": "string",
      "enum": ["audio/wav"],
      "default": "audio/wav"
    },
    "voices": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "speaker": {"type": "string", "minLength": 1},
          "style": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
